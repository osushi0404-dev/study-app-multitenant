{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Edit(docs/**)",
      "Edit(docs/issues/**)",
      "Edit(backend/**)",
      "Edit(frontend/**)",
      "Edit(scripts/claude/**)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(python3 scripts/*)",
      "Bash(bash scripts/claude/*)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m json.tool *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr checks *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose build *)",
      "Bash(docker compose restart *)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose build *)",
      "Bash(docker-compose restart *)",
      "Bash(docker compose port *)",
      "Bash(RATELIMIT_ENABLE=false docker compose up *)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_emulate_media",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(psql *)",
      "Edit(.github/workflows/**)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(.secrets.baseline)",
      "Edit(backend/Dockerfile)",
      "Edit(backend/Dockerfile.dev)",
      "Edit(frontend/Dockerfile)",
      "Edit(frontend/Dockerfile.dev)",
      "Edit(frontend/nginx.conf)",
      "Edit(backend/requirements*.txt)",
      "Edit(backend/pyproject.toml)",
      "Edit(frontend/package.json)",
      "Edit(frontend/package-lock.json)",
      "Edit(**/migrations/*.py)",
      "Edit(backend/init-db.sql)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(rm -rf / *)",
      "Bash(git push origin develop)",
      "Bash(git push origin main)",
      "Bash(git push -u origin develop)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push * --force*)",
      "Read(**/.env)",
      "Read(**/.env.e2e)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.e2e)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/sessionstart_context.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/posttooluse_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request|mcp__github__update_pull_request_branch|mcp__github__create_pull_request_review",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
