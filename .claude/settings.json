{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Write(backend/**)",
      "Edit(backend/**)",
      "Write(frontend/**)",
      "Edit(frontend/**)",
      "Bash(mv docs/*/open/* docs/*/closed/)",
      "Bash(rm docs/*/open/*)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git push -u origin *)",
      "Bash(python3 scripts/*)",
      "Bash(bash scripts/claude/*)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m json.tool *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr checks *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose build *)",
      "Bash(docker compose restart *)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose build *)",
      "Bash(docker-compose restart *)",
      "Bash(docker compose exec backend python manage.py test *)",
      "Bash(docker compose exec backend pytest *)",
      "Bash(docker compose exec frontend npm test *)",
      "Bash(docker compose exec frontend npm run lint *)",
      "Bash(docker compose exec frontend npm run typecheck *)",
      "Bash(docker-compose exec backend python manage.py test *)",
      "Bash(docker-compose exec backend pytest *)",
      "Bash(docker-compose exec frontend npm test *)",
      "Bash(docker-compose exec frontend npm run lint *)",
      "Bash(docker-compose exec frontend npm run typecheck *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git cherry-pick *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose run *)",
      "Bash(docker compose down *)",
      "Bash(docker-compose exec *)",
      "Bash(docker-compose run *)",
      "Bash(docker-compose down *)",
      "Bash(psql *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(rm -rf / *)",
      "Bash(git push origin develop)",
      "Bash(git push origin main)",
      "Bash(git push -u origin develop)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push * --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/posttooluse_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude/hooks/pretooluse_guard.py"
          }
        ]
      }
    ]
  }
}
