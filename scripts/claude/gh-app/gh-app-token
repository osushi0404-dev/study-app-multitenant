#!/usr/bin/env bash
# GitHub App（osushi0404-claude）の 1 時間の鍵を標準出力に出す。残り 10 分を切ったら取り直す（I223）。
# GH_APP_READONLY=1 のときは読み取りだけの鍵（テスト用のセッション向け）。控えは書き込みの鍵と別のファイルにし、
# GitHub の応答の権限がすべて read でなければ鍵を出さずに止める。
# 秘密の鍵ファイルと控えは $HOME の下だけに置く（リポジトリに入れない）。設定の手順: docs/runbooks/github-app-setup.md
set -euo pipefail
CLIENT_ID="${GH_APP_CLIENT_ID:-Iv23licv2TJyaXdBHe4W}"          # 秘密ではない（App の公開の番号）
INSTALLATION_ID="${GH_APP_INSTALLATION_ID:-178606088}"         # 同上
REPO="${GH_APP_REPO:-study-app-multitenant}"
KEY="${GH_APP_KEY:-${HOME}/.config/github-app/app.pem}"
CACHE_DIR="${GH_APP_CACHE_DIR:-${HOME}/.cache/github-app}"
READ_PERMS='{"contents":"read","issues":"read","pull_requests":"read","metadata":"read","actions":"read","checks":"read","statuses":"read"}'
if [ -n "${GH_APP_READONLY:-}" ]; then
  CACHE="${CACHE_DIR}/token-readonly"
  PERMS=",\"permissions\":${READ_PERMS}"
else
  CACHE="${CACHE_DIR}/token"
  PERMS=""
fi
umask 077
printf -v now '%(%s)T' -1   # gh・git を呼ぶたびに通るので、プロセスを起こさずに時刻を取る
if [ -f "$CACHE" ]; then
  read -r exp tok < "$CACHE" || true
  if [ -n "${exp:-}" ] && [ "$now" -lt $((exp - 600)) ]; then
    printf '%s\n' "$tok"; exit 0
  fi
fi
b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now-60)) $((now+540)) "$CLIENT_ID" | b64)
sig=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$KEY" -binary | b64)
resp=$(curl -fsS --max-time 20 -X POST \
  -H "Authorization: Bearer ${header}.${payload}.${sig}" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  -d "{\"repositories\":[\"${REPO}\"]${PERMS}}" \
  "https://api.github.com/app/installations/${INSTALLATION_ID}/access_tokens")
tok=$(printf '%s' "$resp" | python3 -I -c '
import json, os, sys
d = json.load(sys.stdin)
if os.environ.get("GH_APP_READONLY"):
    perms = d.get("permissions")
    if not isinstance(perms, dict) or not perms or any(v != "read" for v in perms.values()):
        sys.exit("gh-app-token: 読み取りだけの鍵を受け取れませんでした（権限: %r）" % (perms,))
print(d["token"])
')
mkdir -p "$CACHE_DIR"
tmp=$(mktemp "${CACHE_DIR}/token.XXXXXX")
printf '%s %s\n' "$((now + 3600))" "$tok" > "$tmp"
mv -f "$tmp" "$CACHE"
printf '%s\n' "$tok"
