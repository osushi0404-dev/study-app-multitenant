# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=learning_app
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (SendGrid)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@learningapp.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# パスキー（WebAuthn・I619）。RP ID は画面の host（またはその親のドメイン）、origin は画面の URL（ポートまで）。
# 本番（DEBUG=False）では https の origin が必須（accounts.checks が止める）。RP ID を後で変えると登録済みのパスキーは使えなくなる
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=学習アプリ
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
# 管理者が発行する登録用リンクの土台（I620）。省略すると WEBAUTHN_ALLOWED_ORIGINS の最初の値（パスキーが通る画面）
# REGISTRATION_LINK_BASE_URL=http://localhost:3000

# OpenAI API
OPENAI_API_KEY=your-openai-api-key

# Logging
DJANGO_LOG_LEVEL=INFO
